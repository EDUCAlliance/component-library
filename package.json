{
  "name": "@EDUCAlliance/component-library",
  "version": "1.0.7",
  "description": "Vue 3 component library made for EDUC Alliance applications.",
  "type": "module",
  "main": "./dist/educ-component-library.cjs.js",
  "module": "./dist/educ-component-library.es.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/educ-component-library.es.js",
      "require": "./dist/educ-component-library.cjs.js"
    },
    "./dist/style.css": "./dist/component-library.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-types",
    "src/assets/tailwind-config.css",
    "src/assets/theme.css",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui-components",
    "tailwindcss",
    "educ"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/educalliance/component-library/.git"
  },
  "bugs": {
    "url": "https://github.com/educalliance/component-library/issues"
  },
  "homepage": "https://github.com/educalliance/component-library#readme",
  "author": "Lukáš Pánek <panek@czs.muni.cz>",
  "license": "MIT",
  "publishConfig": {
    "access": "private",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build:lib": "run-s build:lib:js build:lib:css build:types build:copy-styles",
    "build:lib:js": "vite build",
    "build:lib:css": "vite build --config vite.config.styles.ts && rm -f dist/styles-temp.js",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:copy-styles": "node scripts/copy-styles.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "prepublishOnly": "bun run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@headlessui/vue": "^1.7.23",
    "@vueuse/core": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.507.0",
    "reka-ui": "^2.2.1",
    "tailwind-merge": "^3.2.0",
    "vue-sonner": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-onboarding": "^9.1.2",
    "@storybook/addon-vitest": "9.1.2",
    "@storybook/blocks": "^8.6.14",
    "@storybook/vue3-vite": "^9.1.2",
    "@tailwindcss/postcss": "^4.1.4",
    "@tsconfig/node22": "^22.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vitest/browser": "3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "chromatic": "^11.28.2",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-storybook": "^9.1.2",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "playwright": "^1.51.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "storybook": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^3.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
